<?xml version="1.0" encoding="UTF-8"?>

    <!-- chatgpt -->

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">


    <xs:simpleType name="IdopontTipus">
        <xs:restriction base="xs:string">
            <xs:pattern value="([0-9]|1[0-9]|2[0-3]):[0-5][0-9]"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="OraTipus">
        <xs:restriction base="xs:string">
            <xs:enumeration value="Elmélet"/>
            <xs:enumeration value="Gyakorlat"/>
            <xs:enumeration value="Szeminárium"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="NapTipus">
        <xs:restriction base="xs:string">
            <xs:enumeration value="Hétfő"/>
            <xs:enumeration value="Kedd"/>
            <xs:enumeration value="Szerda"/>
            <xs:enumeration value="Csütörtök"/>
        </xs:restriction>
    </xs:simpleType>


    <xs:element name="OP9WRO_orarend">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="ora" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="targy" type="xs:string"/>
                            <xs:element name="idopont">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="nap"
                                                  type="NapTipus"/>
                                        <xs:element name="tol"
                                                  type="IdopontTipus"/>
                                        <xs:element name="ig"
                                                  type="IdopontTipus"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="helyszin"
                                      type="xs:string"/>
                            <xs:element name="oktato"
                                      type="xs:string"/>
                            <xs:element name="szak"
                                      type="xs:string"/>
                        </xs:sequence>
                        <xs:attribute name="id"
                                      type="xs:string"
                                      use="required"/>
                        <xs:attribute name="tipus"
                                      type="OraTipus"
                                      use="required"/>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>
